# 1 "C:\Users\ADMIN\AppData\Local\Temp\claude\d--ALSM\28ae00cf-b957-4173-b1c8-e010ec273b2a\scratchpad\cobol_stage\PILOTPRT.cob"  
       IDENTIFICATION  DIVISION.
       PROGRAM-ID. PILOTPRT
       DATE-WRITTEN.   04/30/74.
       DATE-COMPILED.  04/30/74.
      *>                                                                 
      *>                                                                 
      *>                                                                 
      *>                                                                 
       ENVIRONMENT DIVISION.
       CONFIGURATION   SECTION.
       SOURCE-COMPUTER.    IBM-370.
       OBJECT-COMPUTER.    IBM-370.
      *>                                                                 
       SPECIAL-NAMES.
           C01     IS  SKPCH01.
      *>                                                                 
      *>                                                                 
       INPUT-OUTPUT    SECTION.
       FILE-CONTROL.
           SELECT  PRTFILE ASSIGN  UT-S-PRT1.
      *>                                                                 
      *>                                                                 
      *>                                                                 
       DATA    DIVISION.
       FILE    SECTION.
      *>                                                                 
       FD  PRTFILE BLOCK CONTAINS 0 RECORDS
           RECORDING   MODE    IS  F
           LABEL   RECORD      IS  OMITTED
           DATA    RECORD      IS  PRTREC.
      *>                                                                 
       01  PRTREC.
           02  PRTDATA         PICTURE X(132).
      *>                                                                 
      *>                                                                 
      *>                                                                 
       WORKING-STORAGE SECTION.
      *>                                                                 
       01  DATAPRT.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(10)   VALUE   '1234567890'.
           02  FILLER          PICTURE X(2)    VALUE   '12'.
      *>                                                                 
      *>                                                                 
      *>                                                                 
       01  DISPA   PICTURE X(16)   VALUE   'M PILOTPRT BEGIN'.
       01  DISPB   PICTURE X(16)   VALUE   'M PILOTPRT END  '.
      *>                                                                 
       01  PRINTPAGE           PICTURE 9(3)    VALUE   2.
       01  PRINTLINES          PICTURE 9(3)    VALUE   54.
       01  PRINTLINESW         PICTURE 9(3)    VALUE   0.
      *>                                                                 
       PROCEDURE   DIVISION.
       STARTX.
           DISPLAY DISPA   UPON    CONSOLE.
           OPEN    OUTPUT  PRTFILE.
           MOVE    SPACE   TO  PRTREC.
           PERFORM PRTSUBA THRU    PRTSUBAEXIT PRINTPAGE   TIMES.
           CLOSE   PRTFILE.
           DISPLAY     DISPB   UPON    CONSOLE.
           STOP    RUN.
      *>                                                                 
      *>                                                                 
      *>                                                                 
       PRTSUBA.
           MOVE    DATAPRT     TO  PRTDATA.
           WRITE   PRTREC  AFTER   SKPCH01.
           COMPUTE PRINTLINESW =   PRINTLINES  -   1.
           PERFORM PRTSUBB THRU    PRTSUBBEXIT PRINTLINESW TIMES.
       PRTSUBAEXIT.
           EXIT.
      *>                                                                 
       PRTSUBB.
           MOVE    DATAPRT     TO  PRTDATA
           WRITE   PRTREC  AFTER   1   LINES.
       PRTSUBBEXIT.
           EXIT.
      *>                                                                 
      *>                                                                 
      *>                                                                 
